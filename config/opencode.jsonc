{
  "$schema": "https://opencode.ai/config.json",
  // Free, no key needed. Slim's preset picks each agent's models; this is only the fallback default.
  "model": "opencode/big-pickle",
  "plugin": ["oh-my-opencode-slim"],
  // Run every tool without asking, so helpers aren't stopped by prompts. For approval prompts on shell
  // commands instead, use: "permission": { "bash": "ask" }
  "permission": "allow"

  // Optional: a model on your own machine as a last step that never runs out. See README, "Adding a local model".
  // "provider": {
  //   "ollama": {
  //     "npm": "@ai-sdk/openai-compatible",
  //     "models": { "qwen3-coder:30b": { "tool_call": true } },
  //     "options": { "baseURL": "http://localhost:11434/v1" }
  //   }
  // }
}
